# ===== LLM API Keys =====
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 回复生成专用 key（与意图/Agent 编排的 key 分离，可选）
REPLY_API_KEY=your_reply_api_key_here

# ===== Embedding & Reranker =====
EMBEDDING_MODEL=text-embedding-v4
RERANKER_MODEL=qwen3-rerank

# ===== LLM =====
LLM_MODEL=deepseek-v4-flash
# 意图识别小模型（默认复用 LLM_MODEL，可指定更廉价模型）
INTENT_MODEL=deepseek-v4-flash
# 大模型 Tool Calling 最大迭代轮次
MAX_AGENT_ITERATIONS=3

# ===== PostgreSQL =====
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_db_password_here
PG_DATABASE=endfield_rag
