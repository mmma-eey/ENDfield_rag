  "abilities": [
    {
      "ordinal": 1,
      "ability_id": "eny_0075_lbroshan_ability_1",
      "description": "进攻连绵不绝。即使截断他的攻势，他也仍有可能再次发动攻击。"
    },
    {
      "ordinal": 2,
      "ability_id": "eny_0075_lbroshan_ability_2",
      "description": "会在地面布撒臂甲上的爆反装甲碎片，如果不慎踩到需要立刻离开。"
    },
    {
      "ordinal": 3,
      "ability_id": "eny_0075_lbroshan_ability_3",
      "description": "会尝试回收地面上的装甲碎片重整旗鼓，若成功回收会发动强大的攻击。"
    }
  ],
  "drops": [
    {
      "name": "破城者拳甲",
      "item_id": "item_drop_lbroshan_1",
      "rarity": 4
    }
  ],
  "tips": [
    "尽可能踩掉全部装甲碎片，以免碾骨破城者回收碎片重振旗鼓。但记得迅速离开碎片的爆炸范围。",
    "小心应对碾骨破城者的连续攻击。即使截断他的攻势，他也仍有可能继续发动进攻。"
  ],
