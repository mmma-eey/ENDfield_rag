  "abilities": [
    {
      "ordinal": 1,
      "ability_id": "eny_0125_fdcentur_ability_1",
      "description": "阿莱克琉斯，千夫长触发失衡节点后会掉落造裔武器，主控干员靠近并拾取后可利用造裔武器发动攻击。"
    },
    {
      "ordinal": 2,
      "ability_id": "eny_0125_fdcentur_ability_2",
      "description": "战况焦灼时，阿莱克琉斯，千夫长将从裂隙中召唤分身协同发动进攻。"
    }
  ],
  "drops": [],
  "tips": [
    "拾取造裔武器后，按下便携工具键可以召唤造裔武器发动攻击，从而打断一些无法打断且威力巨大的技能。",
    "在关注阿莱克琉斯，千夫长之外，还应额外关注他分身的动向。"
  ],
