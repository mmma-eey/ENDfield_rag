  "abilities": [
    {
      "ordinal": 1,
      "ability_id": "eny_0081_ruanyi_ability_1",
      "description": "阮一能够弹开所有的攻击。需要利用息壤破除他的防护，才能对他造成有效伤害。"
    },
    {
      "ordinal": 2,
      "ability_id": "eny_0081_ruanyi_ability_2",
      "description": "生命值较低时会进入激怒状态，利用息壤能够破除该状态并使其陷入长时间的虚弱。"
    },
    {
      "ordinal": 3,
      "ability_id": "eny_0081_ruanyi_ability_3",
      "description": "阮一处于激怒状态时，会召唤主控干员靠近时爆炸的怒火孽根。"
    },
    {
      "ordinal": 4,
      "ability_id": "eny_0081_ruanyi_ability_4",
      "description": "战场中会聚集息壤能量协助战斗，关键时刻触碰息壤能量可将其激活压制阮一。"
    }
  ],
  "drops": [],
  "tips": [
    "阮一能够弹开所有的攻击。需要利用息壤破除他的防护，才能对他造成有效伤害。",
    "血量降低至一定程度，会进入激怒状态，利用息壤能够破除该状态并陷入长时间的虚弱。",
    "阮一处于激怒状态时，会召唤怒火孽根，主控干员靠近时会爆炸。",
    "场上会聚集息壤能量协助战斗，关键时刻利用息壤能量可压制阮一。"
  ],
  "variants": []
