  "abilities": [
    {
      "ordinal": 1,
      "ability_id": "eny_0078_nefarp1_ability_1",
      "description": "会斩出无法靠闪避来躲避的超域能量波。需要利用庄方宜的息壤支援，跃至空中躲避。"
    },
    {
      "ordinal": 2,
      "ability_id": "eny_0078_nefarp1_ability_2",
      "description": "会跃至高空进行蓄力攻击。需要在利用息壤跳起后，使用下落攻击召唤闪电打断。"
    }
  ],
  "drops": [],
  "tips": [
    "用便携工具键的跃起能力，进行下落攻击，会召唤闪电攻击附近敌人。\n即使敌人在空中，闪电也可以打断敌人的蓄力。"
  ],
