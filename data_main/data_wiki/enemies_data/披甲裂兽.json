  "abilities": [
    {
      "ordinal": 1,
      "ability_id": "eny_0113_jzogre_ability_1",
      "description": "背上的山犼兽可投掷香蕉皮，披甲裂兽若贸然发起冲锋攻击，不慎踩到香蕉皮便会打滑摔倒。"
    },
    {
      "ordinal": 2,
      "ability_id": "eny_0113_jzogre_ability_2",
      "description": "蜷身防御时手部是它唯一的弱点，打破手臂会让它退出蜷缩防御并倒地。"
    },
    {
      "ordinal": 3,
      "ability_id": "eny_0113_jzogre_ability_3",
      "description": "倒地时山犼兽会掉落，攻击山犼兽会造成更高的伤害。"
    }
  ],
