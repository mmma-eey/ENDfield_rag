  "abilities": [
    {
      "ordinal": 1,
      "ability_id": "eny_0045_agtrinit_ability_1",
      "description": "拥有三种不同的形态。"
    },
    {
      "ordinal": 2,
      "ability_id": "eny_0045_agtrinit_ability_2",
      "description": "强攻形态：会不断发动凌厉的近战攻击。如果能及时打断它的蓄力，可以对其累积大量失衡值。"
    },
    {
      "ordinal": 3,
      "ability_id": "eny_0045_agtrinit_ability_3",
      "description": "搜查形态：会召唤大量天使助战，并发动锚点冲击波。"
    },
    {
      "ordinal": 4,
      "ability_id": "eny_0045_agtrinit_ability_4",
      "description": "诡计形态：会隐藏身形，从远处倾泻弹幕、进行伏击。打破其隐形的话，可以对其累积大量失衡值。"
    }
  ],
  "drops": [],
  "tips": [
    "强攻形态：如果能及时打断它的技能蓄力，可以对其累积高额失衡值。",
    "搜查形态：要注意靠近源石树枝，躲避大型锚点波。从地面袭来的小型锚点波可以用跳跃躲避。",
    "诡计形态：打破其隐形的话，可以累积大量失衡值。施放一些技能时，三位一体不会移动，也许是用普通攻击打破隐形的好时机。"
  ],
